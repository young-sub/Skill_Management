{
  "hooks": {
    "UserPromptSubmit": [{
      "hooks": [{
        "type": "command",
        "command": "python -c \"import os,runpy; runpy.run_path(os.path.join(os.environ.get('CLAUDE_PLUGIN_ROOT') or os.environ['PLUGIN_ROOT'],'hooks','workflow_context.py'),run_name='__main__')\"",
        "timeout": 30,
        "additionalContextLimit": 6000,
        "statusMessage": "Reading project workflow obligations"
      }]
    }],
    "Stop": [{
      "hooks": [{
        "type": "command",
        "command": "python -c \"import os,runpy; runpy.run_path(os.path.join(os.environ.get('CLAUDE_PLUGIN_ROOT') or os.environ['PLUGIN_ROOT'],'hooks','completion_guard.py'),run_name='__main__')\"",
        "timeout": 15,
        "statusMessage": "Checking final edits were exercised"
      }]
    }]
  }
}
