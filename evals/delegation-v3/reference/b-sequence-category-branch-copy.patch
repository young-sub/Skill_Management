+export async function duplicateCategory(db: AccountDatabase, id: string, raw: unknown) {
+  const input = duplicateCategorySchema.parse(raw);
+  const all = await listCategories(db, true, false);
+  const current = all.find((category) => category.id === id);
+  if (!current) return null;
+  const byParent = new Map<string, (typeof all)[number][]>();
+  for (const category of all) {
+    if (!category.parentId) continue;
+    const group = byParent.get(category.parentId) ?? [];
+    group.push(category);
+    byParent.set(category.parentId, group);
+  }
+  for (const group of byParent.values()) {
+    group.sort((left, right) => left.sortOrder - right.sortOrder || left.nameKo.localeCompare(right.nameKo, "ko"));
+  }
+  const branch: (typeof all)[number][] = [];
+  const visit = (category: (typeof all)[number]) => {
+    branch.push(category);
+    for (const child of byParent.get(category.id) ?? []) visit(child);
+  };
+  visit(current);
+  const parent = input.parentId ? all.find((category) => category.id === input.parentId) : undefined;
+  if (input.parentId && !parent) throw new Error("category_hierarchy_invalid");
+  const branchHeight = Math.max(...branch.map((category) => category.depth - current.depth + 1));
+  if ((parent?.depth ?? 0) + branchHeight > 3) throw new Error("category_hierarchy_invalid");
+
+  const now = new Date().toISOString();
+  const siblings = all.filter((category) => category.parentId === input.parentId);
+  const rootSortOrder = siblings.length ? Math.max(...siblings.map((category) => category.sortOrder)) + 10 : 10;
+  const ids = new Map(branch.map((category) => [category.id, crypto.randomUUID()]));
+  const statements = branch.map((category, index) => db.prepare(`INSERT INTO categories
+    (owner_id,id,parent_id,name_ko,default_template_key,icon_key,sort_order,is_active,created_at,updated_at)
+    VALUES (${ownerValue(db)},?,?,?,?,?,?,?,?,?)`).bind(
+      ids.get(category.id)!,
+      index === 0 ? input.parentId : ids.get(category.parentId!)!,
+      index === 0 ? input.nameKo : category.nameKo,
+      null,
+      category.iconKey,
+      index === 0 ? rootSortOrder : category.sortOrder,
+      category.isActive ? 1 : 0,
+      now,
+      now,
+    ));
+  try {
+    await db.batch(statements);
+  } catch (cause) {
+    if (cause instanceof Error && cause.message.includes("UNIQUE")) throw new Error("category_duplicate", { cause });
+    throw cause;
+  }
+  const created = new Map((await listCategories(db, true, false)).map((category) => [category.id, category]));
+  return [...ids.values()].map((newId) => created.get(newId)!);
+}
