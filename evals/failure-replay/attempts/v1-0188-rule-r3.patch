diff --git a/tests/productDescriptionLimit.test.ts b/tests/productDescriptionLimit.test.ts
new file mode 100644
index 0000000..d0da52b
--- /dev/null
+++ b/tests/productDescriptionLimit.test.ts
@@ -0,0 +1,101 @@
+import { env } from "cloudflare:workers";
+import { describe, expect, it } from "vitest";
+import { accountDatabase } from "../src/worker/accountData";
+import { addProductCatalog, applyProductCatalogImport } from "../src/worker/productCatalog";
+import { createTestAccount, fixtureDatabase, fixtureFetch } from "./accountFixture";
+
+// 상품 설명은 저장 시점에 300자까지만 허용한다. 300자를 넘는 내용은 어떤 저장 경로로도 들어가지 않는다.
+const message = "상품 설명은 300자 이내로 입력해 주세요.";
+const request = (path: string, init?: RequestInit) => fixtureFetch(`http://localhost${path}`, {
+  ...init,
+  headers: init?.body ? { "content-type": "application/json", origin: "http://localhost", ...init.headers } : init?.headers,
+});
+const post = (path: string, body: unknown) => request(path, { method: "POST", body: JSON.stringify(body) });
+const patch = (path: string, body: unknown) => request(path, { method: "PATCH", body: JSON.stringify(body) });
+const create = (nameKo: string, descriptionKo: string) => post("/api/products", {
+  categoryId: "category-supplements", nameKo, descriptionKo, offers: [{ quantity: 1, unitCode: "bottle", priceKrw: 1000 }],
+});
+const storedDescription = (id: string) => (env as Env).DB.prepare("SELECT description_ko FROM products WHERE id = ?").bind(id).first<string>("description_ko");
+const legacyProduct = async (nameKo: string) => {
+  const created = ((await (await create(nameKo, "기존 설명")).json()) as any).data;
+  await (env as Env).DB.prepare("UPDATE products SET description_ko = ? WHERE id = ?").bind("가".repeat(400), created.id).run();
+  return created as { id: string; version: number };
+};
+
+describe("product description 300-character limit", () => {
+  it("creates a product at 300 characters and refuses 301 or a value that normalizes past 300", async () => {
+    const accepted = await create(`설명 300자 ${crypto.randomUUID()}`, "가".repeat(300));
+    expect(accepted.status).toBe(201);
+    expect(await storedDescription(((await accepted.json()) as any).data.id)).toHaveLength(300);
+
+    for (const descriptionKo of ["가".repeat(301), "㈜".repeat(150)]) {
+      const nameKo = `설명 초과 ${crypto.randomUUID()}`;
+      const refused = await create(nameKo, descriptionKo);
+      expect(refused.status).toBe(400);
+      expect(((await refused.json()) as any).error.message).toBe(message);
+      expect(await (env as Env).DB.prepare("SELECT COUNT(*) AS count FROM products WHERE name_ko = ?").bind(nameKo).first("count")).toBe(0);
+    }
+  });
+
+  it("refuses a 301-character update and keeps the stored description", async () => {
+    const created = ((await (await create(`설명 수정 ${crypto.randomUUID()}`, "짧은 설명")).json()) as any).data;
+    const refused = await patch(`/api/products/${created.id}`, { expectedVersion: created.version, descriptionKo: "가".repeat(301) });
+    expect(refused.status).toBe(400);
+    expect(((await refused.json()) as any).error.message).toBe(message);
+    expect(await storedDescription(created.id)).toBe("짧은 설명");
+    expect((await patch(`/api/products/${created.id}`, { expectedVersion: created.version, descriptionKo: "나".repeat(300) })).status).toBe(200);
+  });
+
+  it("does not write an existing over-limit description again through update or duplicate", async () => {
+    const legacy = await legacyProduct(`기존 긴 설명 ${crypto.randomUUID()}`);
+    const resend = await patch(`/api/products/${legacy.id}`, { expectedVersion: legacy.version, descriptionKo: "가".repeat(400) });
+    expect(resend.status).toBe(400);
+    expect(((await resend.json()) as any).error.message).toBe(message);
+
+    const duplicate = await post(`/api/products/${legacy.id}/duplicate`, {});
+    expect(duplicate.status).toBe(400);
+    expect(((await duplicate.json()) as any).error.message).toBe(message);
+    expect(await (env as Env).DB.prepare("SELECT COUNT(*) AS count FROM products WHERE description_ko = ?").bind("가".repeat(400)).first("count")).toBe(1);
+
+    // 설명을 다시 저장하지 않는 변경(사용 중지)은 기존 상품을 그대로 둔다.
+    const deactivate = await patch(`/api/products/${legacy.id}`, { expectedVersion: legacy.version, isActive: false });
+    expect(deactivate.status).toBe(200);
+    expect(await storedDescription(legacy.id)).toHaveLength(400);
+  });
+
+  it("marks a 301-character workbook row invalid and creates nothing from it", async () => {
+    const nameKo = `엑셀 긴 설명 ${crypto.randomUUID()}`;
+    const rows = [{ rowNumber: 2, categoryNameKo: "영양제", nameKo, descriptionKo: "가".repeat(301), priceKrw: 1000, unitLabel: "병" }];
+    const preview = ((await (await post("/api/product-import/preview", { rows })).json()) as any).data;
+    expect(preview).toMatchObject({ invalidRows: 1, createRows: 0 });
+    expect(preview.rows[0].messages).toContain("설명은 1~300자로 입력해 주세요.");
+    const applied = ((await (await post("/api/product-import/apply", { rows })).json()) as any).data;
+    expect(applied.createdRows).toBe(0);
+    expect(await (env as Env).DB.prepare("SELECT COUNT(*) AS count FROM products WHERE name_ko = ?").bind(nameKo).first("count")).toBe(0);
+  });
+
+  it("refuses to add a public catalog product with a 301-character account description", async () => {
+    const catalogId = `catalog-description-limit-${crypto.randomUUID()}`;
+    await applyProductCatalogImport(fixtureDatabase(), {
+      schemaVersion: 2, reviewStatus: "approved", products: [{ id: catalogId, kind: "supplement", sourceKind: "i0030", officialId: catalogId, nameKo: "설명 길이 건기식", manufacturerKo: "제조사", status: "published", collectedAt: "2026-10-03T00:00:00.000Z", contentHash: `hash-${catalogId}` }], descriptions: [], packages: [],
+    }, "fixture-operator");
+    const account = await createTestAccount("customer");
+    const category = (await (await account.request("/categories", "POST", { nameKo: `설명-${crypto.randomUUID()}`, sortOrder: 1 })).json() as any).data;
+    const db = accountDatabase((env as Env).DB, account.id);
+    const item = { catalogProductId: catalogId, categoryId: category.id, quantity: 1, unitCode: "box", priceKrw: 1200 };
+    await expect(addProductCatalog(db, { items: [{ ...item, override: { descriptionKo: "가".repeat(301) } }] }, account.id)).rejects.toThrow(message);
+    expect(await (env as Env).DB.prepare("SELECT COUNT(*) AS count FROM products WHERE owner_id = ?").bind(account.id).first("count")).toBe(0);
+  });
+
+  it("blocks restoring a new or changed description over 300 characters but keeps an unchanged one", async () => {
+    const legacy = await legacyProduct(`복원 기존 설명 ${crypto.randomUUID()}`);
+    const backup = (await (await request("/api/admin/backup")).json()) as any;
+    const unchanged = ((await (await post("/api/admin/restore/preview", { mode: "update", backup })).json()) as any).data;
+    expect(unchanged.conflicts.filter((conflict: any) => conflict.code === "description_too_long")).toEqual([]);
+
+    backup.data.products.find((item: any) => item.id === legacy.id).description_ko = "나".repeat(301);
+    const changed = ((await (await post("/api/admin/restore/preview", { mode: "update", backup })).json()) as any).data;
+    expect(changed).toMatchObject({ canApply: false, conflicts: expect.arrayContaining([expect.objectContaining({ domain: "products", code: "description_too_long", key: legacy.id, message })]) });
+    expect(await storedDescription(legacy.id)).toBe("가".repeat(400));
+  });
+});
