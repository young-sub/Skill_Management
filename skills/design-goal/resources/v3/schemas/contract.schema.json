{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-harness.local/schemas/v3/contract.schema.json",
  "title": "Agent Harness Item contract v3",
  "type": "object",
  "required": ["schema_version", "work_id", "goal", "scope", "non_goals", "items"],
  "properties": {
    "schema_version": {"const": 3},
    "work_id": {"type": "string", "minLength": 1},
    "goal": {"type": "string", "minLength": 1},
    "scope": {"type": "string", "minLength": 1},
    "non_goals": {"type": "array", "items": {"type": "string"}},
    "items": {"type": "array", "minItems": 1, "maxItems": 5, "items": {"$ref": "#/$defs/item"}},
    "approval": {"type": "object"},
    "amendments": {"type": "array"},
    "extensions": {"type": "object"}
  },
  "$defs": {
    "item": {
      "type": "object",
      "required": ["id", "title", "behavior_type", "what", "steps", "terms", "tests", "done", "depends_on", "non_goals", "decision", "material_risks", "priority"],
      "properties": {
        "id": {"type": "string"}, "title": {"type": "string"}, "behavior_type": {"enum": ["tool", "api", "ui", "bugfix", "migration"]},
        "what": {"type": "string"}, "steps": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "terms": {"type": "array"}, "tests": {"type": "array", "minItems": 1}, "done": {"type": "array", "minItems": 1},
        "depends_on": {"type": "array", "items": {"type": "string"}}, "non_goals": {"type": "array"},
        "decision": {"type": "object"}, "material_risks": {"type": "array"}, "priority": {"enum": ["core", "optional"]}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
